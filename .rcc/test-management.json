{
  "schema_version": "rcc.validation_test_policy.v1",
  "version": 1,
  "repository": "jenshaberle-dotcom/current-known-good-baseline",
  "suites": {
    "full": {
      "commands": [["{python}", "-m", "pytest", "-q", "tests"]],
      "paths": [],
      "requires": []
    },
    "architecture_lifecycle": {
      "commands": [["{python}", "-m", "pytest", "-q", "tests/test_architecture_lifecycle_self_application.py"]],
      "paths": ["docs/ckgb/architecture_lifecycle.md", "docs/controls/", "docs/governance/"],
      "requires": []
    },
    "rcc_contracts": {
      "commands": [["{python}", "tests/test_rcc_general_pool_hardcut.py"]],
      "paths": [".rcc/", ".github/workflows/", "docs/ckgb/engineering_delivery_control_plane.md"],
      "requires": []
    }
  },
  "actions": {
    "pr_validation": {
      "required": ["full"],
      "default": [],
      "allow_omit": false,
      "impact_selection": false
    },
    "merge": {
      "required": ["full"],
      "default": [],
      "allow_omit": false,
      "impact_selection": false
    },
    "diagnostic": {
      "required": ["architecture_lifecycle"],
      "default": ["rcc_contracts"],
      "allow_omit": true,
      "impact_selection": true
    }
  },
  "effect_semantics": "validation-only"
}
